// Modèle de docs/07-modele-de-donnees.md. Les tables de révision, jeux, série et paiement arrivent avec leurs tickets.
generator client {
  provider = "prisma-client"
  output   = "../src/generated/prisma"
}

datasource db {
  provider = "postgresql"
}

enum Goal {
  SCHOLARSHIP
  WORK
  TRAVEL
  FRIENDS
  STUDIES
  EXAMS
  BUSINESS
  CULTURE
}

enum Cefr {
  A1
  A2
  B1
  B2
  C1
  C2
}

enum ThemePref {
  SYSTEM
  LIGHT
  DARK
}

enum Author {
  USER
  AGENT
  SYSTEM
}

enum MessageKind {
  TEXT
  AUDIO
  IMAGE
}

model User {
  id                String             @id @default(uuid(7)) @db.Uuid
  firstName         String
  goal              Goal // objectif principal
  goals             Goal[]             @default([])
  interests         String[]           @default([])
  level             Cefr               @default(A1)
  birthYear         Int? // pour restreindre les thèmes réservés aux majeurs
  avatar            Json? // silhouette choisie (id, palette, variante) ; null = silhouette grise par défaut
  phoneE164         String?            @unique // format international (+221…), demandé à l'inscription
  phoneVerifiedAt   DateTime? // rempli quand la vérification par SMS sera activée
  smsOptIn          Boolean            @default(false) // consentement séparé aux SMS
  voiceConsentAt    DateTime? // consentement aux enregistrements vocaux ; null = pas de consentement
  locale            String             @default("fr")
  countryCode       String? // ISO 3166-1 alpha-2, pour la devise
  theme             ThemePref          @default(SYSTEM)
  reminderTime      String? // "19:00"
  timezone          String             @default("Africa/Dakar")
  dailyGoalMin      Int                @default(15)
  preferredAccent   String             @default("en-US")
  dataSaver         Boolean            @default(false)
  chatBackground    String             @default("NONE")
  pausedUntil       DateTime?
  xp                Int                @default(0)
  streakDays        Int                @default(0)
  lastActiveDay     DateTime?          @db.Date
  createdAt         DateTime           @default(now())
  updatedAt         DateTime           @updatedAt
  identities        AuthIdentity[]
  refreshTokens     RefreshToken[]
  conversations     Conversation[]
  contactAvatars    ContactAvatar[]
  contactVariants   ContactVariant[]
  levelAnswers      LevelTestAnswer[]
  notebook          NotebookEntry[]
  reviewCards       ReviewCard[]
  activities        DailyActivity[]
  notifications     NotificationLog[]
  pushSubscriptions PushSubscription[]
}

model AuthIdentity {
  id         String    @id @default(uuid(7)) @db.Uuid
  userId     String    @db.Uuid
  provider   String // "email" | "phone" | "google"
  subject    String // e-mail, numéro E.164 ou sub Google
  verifiedAt DateTime?
  createdAt  DateTime  @default(now())
  updatedAt  DateTime  @updatedAt
  user       User      @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@unique([provider, subject])
  @@index([userId])
}

// Jeton de rafraîchissement : seul son hachage est stocké. Une même `familyId` suit les rotations,
// pour révoquer toute la famille si un jeton déjà utilisé est présenté de nouveau.
model RefreshToken {
  id        String    @id @default(uuid(7)) @db.Uuid
  userId    String    @db.Uuid
  tokenHash String    @unique
  familyId  String    @db.Uuid
  expiresAt DateTime
  revokedAt DateTime?
  createdAt DateTime  @default(now())
  updatedAt DateTime  @updatedAt
  user      User      @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@index([userId])
  @@index([familyId])
}

// Réponse à l'une des 5 questions du test de niveau. Refaire le test réécrit les mêmes lignes.
model LevelTestAnswer {
  id        String   @id @default(uuid(7)) @db.Uuid
  userId    String   @db.Uuid
  position  Int // 1 à 5, voir LEVEL_QUESTIONS dans packages/shared
  text      String
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt
  user      User     @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@unique([userId, position])
}

model Topic {
  id        String   @id @default(uuid(7)) @db.Uuid
  slug      String   @unique // "love", "studies", "news", "sport"…
  nameFr    String
  adultOnly Boolean  @default(false) // true pour "love"
  order     Int
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt
  agents    Agent[]
}

model Agent {
  id              String           @id @default(uuid(7)) @db.Uuid
  slug            String           @unique
  name            String
  initials        String
  category        String // "Quotidien" | "Pro" | "Business" | "Voyage" | thème
  topicId         String?          @db.Uuid
  roleFr          String // "Coloc · familier"
  persona         String // description utilisée dans le prompt
  style           String
  voiceId         String // voix TTS fixe
  accent          String // "en-US", "en-GB", "en-NG"…
  bioFr           String           @default("") // présentation affichée sur la fiche
  interests       String[] // centres d'intérêt affichés sur la fiche
  level           String           @default("B1") // niveau de langue du contact : A2, B1, B2 ou C1
  firstMessage    String
  suggestions     String[]
  isPremium       Boolean          @default(false)
  isActive        Boolean          @default(true)
  createdAt       DateTime         @default(now())
  updatedAt       DateTime         @updatedAt
  topic           Topic?           @relation(fields: [topicId], references: [id])
  conversations   Conversation[]
  contactAvatars  ContactAvatar[]
  contactVariants ContactVariant[]

  @@index([topicId])
}

model ContactAvatar {
  id        String   @id @default(uuid(7)) @db.Uuid
  userId    String   @db.Uuid
  agentId   String   @db.Uuid
  avatar    Json // silhouette choisie pour ce contact (id, palette, variante)
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt
  user      User     @relation(fields: [userId], references: [id], onDelete: Cascade)
  agent     Agent    @relation(fields: [agentId], references: [id], onDelete: Cascade)

  @@unique([userId, agentId])
}

model ContactVariant {
  id         String   @id @default(uuid(7)) @db.Uuid
  userId     String   @db.Uuid
  agentId    String   @db.Uuid
  tone       String? // ton choisi pour ce contact : familier, neutre ou soigne
  difficulty String? // niveau choisi pour ce contact : A2, B1, B2 ou C1
  createdAt  DateTime @default(now())
  updatedAt  DateTime @updatedAt
  user       User     @relation(fields: [userId], references: [id], onDelete: Cascade)
  agent      Agent    @relation(fields: [agentId], references: [id], onDelete: Cascade)

  @@unique([userId, agentId])
}

model Conversation {
  id            String    @id @default(uuid(7)) @db.Uuid
  userId        String    @db.Uuid
  agentId       String    @db.Uuid
  lastMessageAt DateTime  @default(now())
  unreadCount   Int       @default(0)
  summary       String? // résumé glissant pour la mémoire (V2)
  createdAt     DateTime  @default(now())
  updatedAt     DateTime  @updatedAt
  user          User      @relation(fields: [userId], references: [id], onDelete: Cascade)
  agent         Agent     @relation(fields: [agentId], references: [id])
  messages      Message[]

  @@unique([userId, agentId])
  @@index([userId, lastMessageAt(sort: Desc)])
}

model Message {
  id             String       @id @default(uuid(7)) @db.Uuid
  conversationId String       @db.Uuid
  clientId       String?      @db.Uuid // idempotence
  author         Author
  kind           MessageKind  @default(TEXT)
  text           String
  audioKey       String? // inutilisée, à retirer (NS-047 : voir mediaKey)
  mediaKey       String? // fichier rangé dans le stockage privé (photo ou vocal)
  mediaProvider  String? // stockage qui le détient : b2, r2
  mediaSeconds   Int? // durée d'un vocal
  translationFr  String?
  readAt         DateTime?
  deletedAt      DateTime? // message supprimé : le texte est effacé, la bulle reste
  editedAt       DateTime? // dernière modification du texte par la personne
  reaction       String? // émoji de la personne sur ce message
  sticker        String? // identifiant du sticker ; `text` porte alors sa légende
  forwarded      Boolean      @default(false) // message transféré depuis une autre conversation
  replyToId      String?      @db.Uuid // message cité quand la personne répond en citant
  createdAt      DateTime     @default(now())
  updatedAt      DateTime     @updatedAt
  conversation   Conversation @relation(fields: [conversationId], references: [id], onDelete: Cascade)
  correction     Correction?
  replyTo        Message?     @relation("Reply", fields: [replyToId], references: [id], onDelete: SetNull)
  replies        Message[]    @relation("Reply")

  @@unique([conversationId, clientId])
  @@index([conversationId, createdAt])
}

model Correction {
  id        String   @id @default(uuid(7)) @db.Uuid
  messageId String   @unique @db.Uuid
  better    String? // null = message déjà parfait
  whyFr     String?
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt
  message   Message  @relation(fields: [messageId], references: [id], onDelete: Cascade)
}

// Le noyau d'anglais parlé, chargé depuis data/*.csv par `pnpm --filter @newstart/api db:seed`.
model Expression {
  id          Int          @id // rang dans data/expressions.csv
  reviewCards ReviewCard[]
  text        String       @unique
  meaningFr   String
  situation   String
  register    String // Familier | Neutre | Poli
  sceneType   String
  week        Int
  frequency   Float
}

model Word {
  id          Int    @id // rang dans data/mots.csv
  text        String @unique
  translation String
  week        Int
  frequency   Float
}

// Code à usage unique envoyé par e-mail ou SMS. Seul son hachage (HMAC) est stocké.
// `signup` garde le profil d'inscription jusqu'à la vérification : le compte n'existe qu'ensuite.
model OtpCode {
  id          String    @id @default(uuid(7)) @db.Uuid
  channel     String // "email" | "sms"
  destination String // e-mail en minuscules ou numéro E.164
  codeHash    String
  attempts    Int       @default(0)
  expiresAt   DateTime
  consumedAt  DateTime?
  signup      Json?
  createdAt   DateTime  @default(now())
  updatedAt   DateTime  @updatedAt

  @@index([destination, createdAt])
  @@index([expiresAt])
}

// Carnet personnel : une copie de la correction au moment de l'ajout, qui reste si le message disparaît.
model NotebookEntry {
  id        String   @id @default(uuid(7)) @db.Uuid
  userId    String   @db.Uuid
  messageId String   @db.Uuid // message d'origine, sert à ne l'ajouter qu'une fois
  original  String
  better    String
  whyFr     String?
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt
  user      User     @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@unique([userId, messageId])
  @@index([userId, createdAt])
}

// Carte de révision FSRS : une par personne et par expression (NS-304).
model ReviewCard {
  id           String     @id @default(uuid(7)) @db.Uuid
  userId       String     @db.Uuid
  expressionId Int
  stability    Float      @default(0)
  difficulty   Float      @default(0)
  due          DateTime   @default(now())
  reps         Int        @default(0)
  lapses       Int        @default(0)
  lastReview   DateTime?
  createdAt    DateTime   @default(now())
  updatedAt    DateTime   @updatedAt
  user         User       @relation(fields: [userId], references: [id], onDelete: Cascade)
  expression   Expression @relation(fields: [expressionId], references: [id], onDelete: Cascade)

  @@unique([userId, expressionId])
  @@index([userId, due])
}

model DailyActivity {
  id            String   @id @default(uuid(7)) @db.Uuid
  userId        String   @db.Uuid
  day           DateTime @db.Date
  spokenSeconds Int      @default(0)
  messagesSent  Int      @default(0)
  gamesPlayed   Int      @default(0)
  xpEarned      Int      @default(0)
  /// Le défi du jour est terminé (le bonus d'XP n'est donné qu'une fois par jour).
  challengeDone Boolean  @default(false)
  user          User     @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@unique([userId, day])
}

/// Journal des notifications : un rappel par personne et par jour au plus (clé unique), et liste de l'écran Notifications.
model NotificationLog {
  id        String    @id @default(uuid(7)) @db.Uuid
  userId    String    @db.Uuid
  kind      String // "reminder"
  day       String // jour local AAAA-MM-JJ, pour la clé unique
  title     String
  body      String
  readAt    DateTime?
  createdAt DateTime  @default(now())
  updatedAt DateTime  @updatedAt
  user      User      @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@unique([userId, kind, day])
  @@index([userId, createdAt])
}

/// Un appareil abonné aux notifications push. L'`endpoint` est unique : le même appareil ne compte qu'une fois, même si la personne change.
model PushSubscription {
  id        String   @id @default(uuid(7)) @db.Uuid
  userId    String   @db.Uuid
  endpoint  String   @unique
  p256dh    String
  auth      String
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt
  user      User     @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@index([userId])
}

/// Une offre d'abonnement (docs/14-paiements.md). Les prix sont dans `PlanPrice`, jamais dans le code.
model Plan {
  code       String      @id
  nameFr     String
  periodDays Int
  renews     Boolean
  position   Int
  prices     PlanPrice[]
}

model PlanPrice {
  planCode    String
  /// "XOF" ou "USD".
  currency    String
  /// Unité mineure : 1 = 1 FCFA, ou 1 centime de dollar.
  amountMinor Int
  plan        Plan   @relation(fields: [planCode], references: [code], onDelete: Cascade)

  @@id([planCode, currency])
}
