# Copier en .env et remplir. Ne jamais committer de vraies valeurs.
NODE_ENV=development
PORT=4000 # port de l'API ; le web écoute sur 3000
LOG_LEVEL=info
# Jobs : inline (phase 1, dans l'API) ou separate (phase 2, apps/worker)
RUN_JOBS=inline

# Base de données (Neon en ligne, PostgreSQL du compose en local)
DATABASE_URL=postgresql://newstart:change-me@localhost:5432/newstart
POSTGRES_USER=newstart
POSTGRES_PASSWORD=change-me
POSTGRES_DB=newstart

# Origines web autorisées à appeler l'API (CORS), séparées par des virgules. Vide = aucune.
# `*` remplace un morceau d'adresse (sans point) : https://new-start-*-yhd.vercel.app
CORS_ORIGINS=

# Redis, facultatif (phase 2 ou quotas)
REDIS_URL=

# Authentification
# Clé privée ES256 (PEM PKCS8 sur une ligne, retours à la ligne écrits \n). Générer : openssl ecparam -name prime256v1 -genkey | openssl pkcs8 -topk8 -nocrypt
JWT_PRIVATE_KEY=
# Clé des codes de connexion, 32 caractères au moins (openssl rand -hex 32). Obligatoire dès qu'il y a plusieurs réplicas.
OTP_SECRET=
GOOGLE_CLIENT_ID=
GOOGLE_CLIENT_SECRET=

# Services externes (adaptateurs factices si vides)
# Brevo : sans clé ou sans MAIL_FROM, les e-mails restent en mémoire (adaptateur factice).
BREVO_API_KEY=
# Adresse d'expédition validée dans Brevo, et nom affiché (défaut : New Start)
MAIL_FROM=
MAIL_FROM_NAME=
# SMS via Brevo : false tant que le budget n'est pas accordé. SMS_SENDER : 3 à 11 caractères alphanumériques.
SMS_ENABLED=false
SMS_SENDER=
CLOUDINARY_URL=
# IA : fournisseur par brique (groq ou gemini pour le LLM, groq pour le STT, gemini pour le TTS).
# Vide, inconnu ou clé manquante : adaptateur factice.
LLM_PROVIDER=
STT_PROVIDER=
TTS_PROVIDER=
GROQ_API_KEY=
GEMINI_API_KEY=
# Plafond d'appels IA par mois et par processus (0 = adaptateur factice seulement, 2000 si vide)
# Messages envoyés par personne et par jour au lancement (60 par défaut).
MESSAGES_PER_DAY=60
AI_MAX_CALLS_PER_MONTH=
# Limite de débit par IP, requêtes par minute (0 = éteinte). Régler d'abord TRUST_PROXY_HOPS (1 derrière Render).
RATE_LIMIT_PER_MINUTE=0
TRUST_PROXY_HOPS=0
# Rappels du jour : intervalle du planificateur en secondes (0 = éteint).
REMINDERS_INTERVAL_SECONDS=0

# Supervision : vide = Sentry éteint. Le DSN va dans les variables de l'hébergeur, jamais dans le dépôt.
SENTRY_DSN=
# Facultatif : nom d'environnement vu dans Sentry (sinon NODE_ENV)
SENTRY_ENVIRONMENT=
# Facultatif : part des requêtes tracées (0 à 1, défaut 0). 0.1 alimente l'alerte de taux d'erreur.
SENTRY_TRACES_SAMPLE_RATE=
# Facultatif : adresse OTLP/HTTP (ex. Grafana Cloud) ; vide = OpenTelemetry éteint. Jeton dans OTEL_EXPORTER_OTLP_HEADERS (secret).
OTEL_EXPORTER_OTLP_ENDPOINT=
# Facultatif : active GET /health/sentry-test (API) et GET /api/sentry-test (web), avec l'en-tête x-sentry-test-token. Au moins 16 caractères ; à retirer après la vérification.
SENTRY_TEST_TOKEN=

# Web Push (VAPID) : les trois ensemble, sinon les notifications push restent en mémoire. La clé privée est un secret (jamais dans ce fichier en vrai).
VAPID_PUBLIC_KEY=
VAPID_PRIVATE_KEY=
VAPID_SUBJECT=

# CI (secrets GitHub, jamais dans ce fichier en vrai)
SONAR_TOKEN=
SONAR_HOST_URL=https://sonarcloud.io

# Web : URL publique de l'API. Vide = pas d'écran « Connexion au serveur… » (local).
NEXT_PUBLIC_API_URL=
# Clé publique VAPID (la même que VAPID_PUBLIC_KEY côté API) : sans elle, le réglage des notifications push reste grisé.
NEXT_PUBLIC_VAPID_PUBLIC_KEY=
# Web : DSN Sentry du navigateur (public par nature). Vide = Sentry éteint.
NEXT_PUBLIC_SENTRY_DSN=
NEXT_PUBLIC_SENTRY_ENVIRONMENT=
