# Copier en .env et remplir. Ne jamais committer de vraies valeurs.
NODE_ENV=development
PORT=3000
LOG_LEVEL=info
# Jobs : inline (phase 1, dans l'API) ou separate (phase 2, apps/worker)
RUN_JOBS=inline

# Base de données (Neon en ligne, PostgreSQL du compose en local)
DATABASE_URL=postgresql://newstart:change-me@localhost:5432/newstart
POSTGRES_USER=newstart
POSTGRES_PASSWORD=change-me
POSTGRES_DB=newstart

# Redis, facultatif (phase 2 ou quotas)
REDIS_URL=

# Authentification
JWT_SECRET=
GOOGLE_CLIENT_ID=
GOOGLE_CLIENT_SECRET=

# Services externes (adaptateurs factices si vides)
BREVO_API_KEY=
CLOUDINARY_URL=
LLM_API_KEY=
STT_API_KEY=
TTS_API_KEY=
# Plafond mensuel de dépense IA en euros (0 = adaptateur factice seulement)
AI_MONTHLY_BUDGET_EUR=0

# Supervision
SENTRY_DSN=

# CI (secrets GitHub, jamais dans ce fichier en vrai)
SONAR_TOKEN=
SONAR_HOST_URL=https://sonarcloud.io
