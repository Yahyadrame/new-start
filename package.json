{
  "name": "new-start",
  "private": true,
  "packageManager": "pnpm@12.18.0",
  "engines": {
    "node": ">=22"
  },
  "scripts": {
    "dev": "turbo run dev",
    "build": "turbo run build",
    "lint": "eslint . && turbo run lint",
    "typecheck": "turbo run typecheck",
    "test": "turbo run test",
    "test:e2e": "turbo run test:e2e",
    "format": "prettier --write .",
    "prepare": "husky",
    "docker:deps": "docker compose -f infra/compose/docker-compose.yml up -d",
    "docker:dev": "docker compose -f infra/compose/docker-compose.yml --profile dev up",
    "docker:prod": "docker compose -f infra/compose/docker-compose.yml --profile prod up --build",
    "docker:clean": "docker compose -f infra/compose/docker-compose.yml --profile \"*\" down --volumes --remove-orphans --rmi local",
    "depcruise": "depcruise packages $(ls -d apps 2>/dev/null) --config .dependency-cruiser.cjs"
  },
  "lint-staged": {
    "*.{ts,tsx,js,mjs,json,yml,yaml}": "prettier --write",
    "*.{ts,tsx,js,mjs}": "eslint --fix"
  },
  "devDependencies": {
    "@commitlint/cli": "^21.2.4",
    "@commitlint/config-conventional": "^21.2.4",
    "@commitlint/lint": "^21.2.4",
    "@commitlint/load": "^21.2.4",
    "@eslint/js": "^10.0.1",
    "@vitest/coverage-v8": "^5.1.0",
    "dependency-cruiser": "^18.7.2",
    "eslint": "^10.14.0",
    "eslint-plugin-boundaries": "^7.4.2",
    "eslint-plugin-security": "^4.2.1",
    "husky": "^9.1.7",
    "lint-staged": "^17.6.0",
    "prettier": "^3.10.0",
    "turbo": "^2.11.11",
    "typescript": "^5.9.3",
    "typescript-eslint": "^8.72.2",
    "vitest": "^5.1.0"
  }
}
